    "/api/v1/devtools/capabilities": {
      "get": {
        "description": "Live capability, from the platform.\n\n*\"Capability is live state, not documentation\"* (09_API \u00a75.2). What a bound\nmodel can actually produce is the difference between a rule that can reach a\nverdict and one that will sit at UNKNOWN forever.",
        "operationId": "capabilities_api_v1_devtools_capabilities_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
