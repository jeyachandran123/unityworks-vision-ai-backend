        "summary": "Capabilities",
        "tags": [
          "devtools"
        ]
      }
    },
    "/api/v1/devtools/compliance": {
      "get": {
        "description": "The live compliance verdicts, and the rules that produced them.\n\nVerdicts are recomputed from current Vision State on each call rather than\nread from a cache, so what this returns is what the rules say *now*. It does\nnot write: incidents are opened by the driver's own pass, and a read that\nraised incidents would make every refresh of a dashboard a business event.",
        "operationId": "compliance_state_api_v1_devtools_compliance_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Compliance State Api V1 Devtools Compliance Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Compliance State",
        "tags": [
          "devtools"
        ]
      }
    },
    "/api/v1/devtools/evidence/{blob_ref}": {
      "get": {
        "description": "Retrieve evidence imagery.\n\nTwo gates beyond DevTools, and neither is implied by the other:\n\n1. `ALLOW_EVIDENCE` \u2014 a deployment decision. Off by default.\n2. `VIEW_EVIDENCE` \u2014 the caller's own privilege. Never implied by\n   `VIEW_OBSERVATIONS`: *\"Reading 'a person was here' and viewing their image\n   are categorically different acts.\"*",
        "operationId": "evidence_api_v1_devtools_evidence__blob_ref__get",
        "parameters": [
          {
            "in": "path",
            "name": "blob_ref",
            "required": true,
            "schema": {
              "title": "Blob Ref",
              "type": "string"
