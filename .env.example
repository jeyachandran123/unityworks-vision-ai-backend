# =============================================================================
# UnityWorks Vision AI — backend environment
#
# Copy to .env and fill in. NEVER commit .env.
#
# Four rules govern this file:
#
#   1. Every security-relevant flag defaults to OFF.
#   2. CCTV_CHANNELS empty means NOTHING runs. Cost follows configuration,
#      not hardware — a 16-channel DVR must not become 16 pipelines.
#   3. Secrets are left blank, never given a placeholder value. There is no
#      "changeme" here, because "changeme" is what ships to production.
#   4. In production the application REFUSES TO START with a default secret,
#      and the error names the variable without printing its value.
#
# Resolution order (later wins):
#   defaults in code → this file → environment → SecretProvider → database
# =============================================================================


# --- Application -------------------------------------------------------------
APP_ENV=development                  # development | production | test
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DEBUG=false                      # REQUIRED false in production.
                                     # Also gates /docs, /redoc and /openapi.json:
                                     # a schema is a map of the attack surface.
APP_NAME=UnityWorks Vision AI

# REQUIRED in production. Generate, do not reuse, do not share between
# environments:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=


# --- Authentication ----------------------------------------------------------
JWT_ALGORITHM=HS256                  # HS256 | RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=unityworks-vision-ai
PASSWORD_MIN_LENGTH=12

# RS256 only. Both are required together when JWT_ALGORITHM=RS256.
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=


# --- Database ----------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=unityworks_vision
DB_USER=postgres
DB_PASSWORD=                         # REQUIRED in production
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false                        # SQL logging. Never true in production —
                                     # query logs contain personal data.

# Replaces the composed URL entirely. Tests use it for SQLite; a managed
# database may use it for a full DSN.
DATABASE_URL_OVERRIDE=


# --- Redis -------------------------------------------------------------------
# Degraded, never fatal. If Redis is unreachable the application still boots and
# still serves every route that does not need it; the ones that do fail at
# request time with the dependency named.
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50


# --- Vision OS: what to observe (the domain, as data) ------------------------
# Comma-separated. A named-but-missing document is a startup error; naming none
# is a valid deployment that declares no attributes and spends no model calls.
VISION_SEMANTIC_POLICY=./config/policies/kitchen-safety.example.json,./config/policies/object-identity.example.json
VISION_VERIFICATION_RULES=./config/policies/verification.example.json
COMPLIANCE_RULES=./config/rules/site-safety.example.json

# Assemble the platform at startup. FALSE in Phase 1: no source adapter is bound
# yet, and a platform with no source would report health while observing
# nothing — which is the one state invariant V8 exists to make unmistakable.
VISION_AUTOSTART=false


# --- Vision OS: detection (read by the platform's own composition root) -------
VISION_DETECTOR_PROVIDER=yolo        # yolo | reference
VISION_DETECTOR_WEIGHTS=./models/yolov8n.onnx
VISION_DETECTOR_CLASSES=person
VISION_DETECTOR_CONFIDENCE=0.4
VISION_DETECTOR_IOU=0.45


# --- Vision OS: understanding (VLM) ------------------------------------------
# Layering: adapter default -> this file -> real environment variable -> secret
# provider. A real environment variable always wins over a file, so an operator
# can name a replacement model for one run without editing anything.
VISION_UNDERSTANDER_PROVIDER=nvidia  # nvidia | ollama | static
VISION_UNDERSTANDER_TIMEOUT_S=

VISION_NVIDIA_API_KEY=            # never commit; never log
VISION_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# The hosted model identifier. SET THIS. Hosted models are retired on the
# vendor's schedule, not ours; when that happens every crop refuses and the
# Alerts page simply goes quiet. Name a model the endpoint actually lists.
#   verified available : minimaxai/minimax-m3
#   RETIRED 2026-08-26 : nvidia/llama-3.1-nemotron-nano-vl-8b-v1  (410 Gone)
VISION_NVIDIA_MODEL=

# Local Ollama. Separate from OLLAMA_HOST so document vision and CCTV
# understanding can run on different machines.
VISION_OLLAMA_BASE_URL=http://192.168.6.118:11434
VISION_OLLAMA_MODEL=

# Longest crop edge sent to the model, in pixels. Vision tokens scale with
# AREA, so this is the main latency lever on a CPU-served model. It is also the
# resolution policy asks for on the head band (Phase 4.2: head accuracy
# 23.3% -> 74.4%). Empty means the adapter default, which is 448.
VISION_UNDERSTANDER_MAX_SIDE=


# --- CCTV (Phase 3 — not read by this phase) ---------------------------------
# Listed here so the deployment shape is known before the code that reads it
# lands. Live ingestion is blocked on TCP 554 reachability at the site.
VIDEO_SOURCE=file                    # file | rtsp
CCTV_HOST=gayatri.freemyip.com
CCTV_RTSP_PORT=554
CCTV_CHANNELS=                       # EXPLICIT allowlist, e.g. 1,2,5,7.
                                     # EMPTY SELECTS NOTHING.
CCTV_STREAM_TYPE=sub                 # sub | main
CCTV_ANALYSIS_FPS=4.0                # independent of camera fps: a 25 fps
                                     # stream must not become 25 fps of VLM work
CCTV_USERNAME=admin
CCTV_CREDENTIAL_REF=                 # PREFERRED — resolved via SecretProviderPort
CCTV_PASSWORD= # development only. Never commit. Never log.
                                     # Never place in an error message.


# --- Evidence & imagery ------------------------------------------------------
# Both default OFF and are DEPLOYMENT decisions, not user settings. Reading
# "a person was here" and viewing their image are categorically different acts.
SERVE_FRAMES=false
ALLOW_EVIDENCE=false

EVIDENCE_STORE=memory                # memory | local. `memory` does not survive
                                     # a restart — a durable, encrypted adapter
                                     # is required before any real deployment.
EVIDENCE_PATH=./data/evidence
EVIDENCE_RETENTION_DAYS=30


# --- Observability -----------------------------------------------------------
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json                      # json | console
METRICS_ENABLED=true                 # /metrics — expose on an internal network only


# --- CORS --------------------------------------------------------------------
# Explicit origins. "*" is refused at startup: a credentialed API that reflects
# arbitrary origins has no same-origin protection left.
CORS_ORIGINS=http://localhost:5273


# --- Feature flags -----------------------------------------------------------
FEATURE_DEVTOOLS=false               # mounts /api/v1/devtools/* at all.
                                     # Each route ALSO requires the
                                     # access_devtools permission.
FEATURE_LIVE_CCTV=false              # Phase 3
